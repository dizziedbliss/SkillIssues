{
  "name": "skillissues-desktop",
  "version": "2.0.0",
  "description": "SkillIssues desktop contribution workspace",
  "author": "SkillIssues",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check app.js",
    "dist": "electron-builder --mac --linux --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.skillissues.desktop",
    "productName": "SkillIssues",
    "icon": "icon.png",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.css",
      "app.js",
      "logo.png",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  }
}