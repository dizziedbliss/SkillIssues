{
  "name": "skillissues-desktop",
  "version": "1.0.0",
  "description": "SkillIssues desktop: find an issue, then fork, fix and open a pull request",
  "author": "SkillIssues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dizziedbliss/SkillIssues.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "dist": "npm run build && electron-builder --mac --linux --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "build": {
    "appId": "com.skillissues.desktop",
    "productName": "SkillIssues",
    "icon": "icon.png",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "publish": {
      "provider": "github",
      "owner": "dizziedbliss",
      "repo": "SkillIssues",
      "releaseType": "release"
    },
    "files": [
      "out/**/*",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "protocols": [
      {
        "name": "SkillIssues",
        "schemes": [
          "skillissues"
        ]
      }
    ],
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkillIssues",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@skillissues/client": "2.0.0",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
