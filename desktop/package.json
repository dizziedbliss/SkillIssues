{
  "name": "skillissues-desktop",
  "version": "2.0.0",
  "description": "SkillIssues desktop contribution workspace",
  "author": "SkillIssues",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac --linux --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.skillissues.desktop",
    "productName": "SkillIssues",
    "icon": "icon.png",
    "asar": true,
    "files": [
      "out/**/*",
      "icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "4.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
