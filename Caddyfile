# Production reverse proxy for the VPS deploy (compose.prod.yaml).
#
# Caddy is the only service publishing ports (80/443) and the only thing
# that terminates TLS — automatic Let's Encrypt via the ACME HTTP-01
# challenge on port 80, no separate certbot step. Frontend and API are
# served same-origin, so the browser sends the session cookie without any
# cross-origin cookie handling.
{
	# Per-host request/latency/status metrics, served by the :9180 block below.
	metrics
}

{$DOMAIN} {
	# Cap bodies at the edge; the API enforces its own, tighter, live limits.
	request_body {
		max_size 26MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# /api/* -> go-api, with the /api prefix stripped: the browser calls
	# https://{$DOMAIN}/api/auth/github/callback, go-api only ever sees
	# /auth/github/callback (its routes have no /api prefix of their own).
	handle_path /api/* {
		# Operational and admin endpoints are internal only: /metrics and
		# /health/detail are scraped on the Docker network, /admin is reached
		# over ssh (see DEPLOYMENT.md). Admin has its own bearer token, but a
		# token is not a reason to put the endpoint on the internet.
		@internal path /metrics /metrics/* /health/detail /admin /admin/*
		handle @internal {
			respond 404
		}
		handle {
			# The API returns JSON only: nothing it serves may load or run anything.
			header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			reverse_proxy go-api:8000
		}
	}

	# Everything else is the SPA, served by the nginx `web` image.
	handle {
		reverse_proxy frontend:80
	}

	encode gzip

	log {
		output stdout
		format json
	}
}

# Prometheus scrape target. Not in `ports:`, so reachable only on the Docker
# network; a dedicated listener avoids exposing the admin API (:2019).
:9180 {
	metrics
}
