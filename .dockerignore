# Root Dockerfile builds with the repo root as context (needed so the web
# target can see packages/markdown). Without this file every build would
# ship the entire repo — including the 3+ GB Kaggle dataset — to the daemon.

.git
.claude

# Local env and secrets — never baked into an image.
.env
.env.*
!.env.example
app.env
*.pem
*.key
*_host_key*
id_ed25519*
id_rsa*

# Kaggle dataset import source and benchmark scratch — large, irrelevant to
# any image build.
data/
benchmark/

# Dependency and build output — reinstalled/rebuilt inside the image.
**/node_modules
**/dist
desktop/out/
backend/bin/
backend/cmd/api/api
backend/cmd/api/api.exe
backend/cmd/ingestd/ingestd
backend/cmd/ingestd/ingestd.exe
backend/cmd/migrate/migrate
backend/cmd/migrate/migrate.exe
backend/cmd/healthcheck/healthcheck
backend/cmd/healthcheck/healthcheck.exe

# Docs — irrelevant to any build, no reason to ship them to the daemon.
*.md
!README.md

.vscode/
*.log
*.tsbuildinfo
.skillissues/
.DS_Store
