        "y": 79,
        "w": 16,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Next in queue",
      "description": "Pending jobs in claim order (FIFO on next_retry_at). A job with attempts > 0 is a retry after an error.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT r.full_name AS repository, j.job_type, j.attempt_count AS attempts, j.next_retry_at AS due, j.last_error_class AS last_error\nFROM ingest_jobs j JOIN repositories r ON r.id = j.repository_id\nWHERE j.status = 'pending'\nORDER BY j.next_retry_at NULLS FIRST, j.id\nLIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
