    {
      "type": "table",
      "title": "Running now",
      "description": "Repositories being crawled this moment. pages_done climbs while a repository is paged; a lease_expires_at in the past means the worker stalled and the job will be reclaimed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT r.full_name AS repository, j.job_type, j.pages_done AS pages, j.has_next_page AS more_pages, j.lease_owner AS worker, j.lease_expires_at AS lease_until, j.updated_at AS last_update\nFROM ingest_jobs j JOIN repositories r ON r.id = j.repository_id\nWHERE j.status = 'running'\nORDER BY j.updated_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
