    {
      "type": "table",
      "title": "Largest open-issue trackers",
      "description": "open_on_github is GitHub's live open-issue count, refreshed on the first page of every crawl pass (repositories.open_issue_count). stored is how many of them SkillIssues holds; the gap is ingest.max_pages_per_repo or a pass still in progress.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A",
          "rawSql": "SELECT r.full_name AS repository, r.open_issue_count AS open_on_github,\n       (SELECT count(*) FROM issues i WHERE i.repository_id = r.id AND i.state = 'OPEN') AS stored,\n       r.metadata_refreshed_at AS refreshed\nFROM repositories r\nWHERE r.open_issue_count IS NOT NULL\nORDER BY r.open_issue_count DESC\nLIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
