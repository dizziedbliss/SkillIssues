          "rawSql": "SELECT 'sent' AS notifications, count(*) AS n FROM notifications WHERE created_at > now() - interval '30 days' UNION ALL SELECT 'read', count(*) FROM notifications WHERE created_at > now() - interval '30 days' AND read_at IS NOT NULL",
