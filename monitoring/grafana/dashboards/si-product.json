    {
      "type": "bargauge",
      "title": "Contribution funnel (all time)",
      "description": "Current state of every contribution. PR_CLOSED is closed without merge.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT s.state, coalesce(c.n, 0) AS contributions FROM unnest(ARRAY['STARTED','PR_OPEN','PR_MERGED','VERIFIED','PR_CLOSED']) WITH ORDINALITY AS s(state, ord) LEFT JOIN (SELECT state, count(*) n FROM contributions GROUP BY state) c USING (state) ORDER BY s.ord",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
