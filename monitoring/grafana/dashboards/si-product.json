    {
      "type": "table",
      "title": "Issue body cache",
      "description": "The GET /issues/{id}/body fallback cache (issue_bodies), trimmed to ingest.bodies.cache_max_mb. Bodies themselves are not readable here.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT count(*) AS bodies, count(*) FILTER (WHERE source = 'archive') AS \"refreshed by archive\", count(*) FILTER (WHERE last_read_at > now() - interval '24 hours') AS \"read in 24h\", pg_size_pretty(pg_total_relation_size('issue_bodies')) AS size, max(fetched_at) AS \"last fetched\" FROM issue_bodies",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
