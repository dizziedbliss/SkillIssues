    {
      "type": "bargauge",
      "title": "Saved issues by state",
      "description": "Open vs closed among issues users saved. A closed one stays saved; its owner gets a notification.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT s.state, coalesce(c.n, 0) AS issues FROM unnest(ARRAY['OPEN','CLOSED']) WITH ORDINALITY AS s(state, ord) LEFT JOIN (SELECT i.state, count(*) n FROM saved_issues sv JOIN issues i ON i.id = sv.issue_id GROUP BY 1) c USING (state) ORDER BY s.ord",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
