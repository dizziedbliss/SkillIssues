    {
      "type": "bargauge",
      "title": "Issues by difficulty (estimate)",
      "description": "From Postgres column statistics (pg_stats), refreshed by ANALYZE: an exact count of every open issue takes longer than the 15 s query limit. Includes the few closed issues still within retention.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT v.difficulty, round(c.reltuples * v.freq)::bigint AS issues FROM pg_class c, LATERAL (SELECT unnest(most_common_vals::text::text[]) AS difficulty, unnest(most_common_freqs) AS freq FROM pg_stats WHERE schemaname = 'public' AND tablename = 'issues' AND attname = 'difficulty') v WHERE c.oid = 'public.issues'::regclass ORDER BY array_position(ARRAY['BEGINNER','INTERMEDIATE','ADVANCED','UNCLASSIFIED'], v.difficulty)",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
