          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT date_trunc('day', merged_at) AS time, count(*) AS merged FROM contributions WHERE merged_at IS NOT NULL AND $__timeFilter(merged_at) GROUP BY 1 ORDER BY 1",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "refId": "B"
