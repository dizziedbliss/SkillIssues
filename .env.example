# ==============================================================================
# SkillIssues Environment Configuration
#
# This file is for local dev (compose.yaml) / hybrid dev. Production
# (compose.prod.yaml, the VPS) uses its own .env placed directly on the host —
# see DEPLOYMENT.md for that; several values below (PORT, SYNCD_URL, the
# GitHub callback URLs) are deliberately different in production.
# ==============================================================================

# --------------------------------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------------------------------
POSTGRES_DB=skillissues
POSTGRES_USER=skillissues
POSTGRES_PASSWORD=skillissues
DATABASE_URL=postgresql://skillissues:skillissues@localhost:5432/skillissues

# Overrides the connection pool's max size (db.DefaultConfig otherwise
# defaults to 20; cmd/api and cmd/ingestd each apply their own smaller
# default — 15 and 10 — when this is unset). Pool size is fixed at creation,
# so changing it needs a restart regardless, which is why this is a
# bootstrap env var rather than a live `settings` row.
# DB_MAX_CONNS=15

# --------------------------------------------------------------------------
# Redis (rate limiting, response caching — NOT sessions; those resolve from
# Postgres, so tests and local dev both pass with Redis stopped)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# URLs & Ports
# --------------------------------------------------------------------------
PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Optional: sets the session cookie's Domain attribute, so a web frontend on
# one subdomain and the API on another share the same cookie. Leave unset for
# a same-origin deployment (the cookie then defaults to the exact host).
# SESSION_COOKIE_DOMAIN=.example.com

# ingestd's own address, used by go-api to forward sync requests to it.
# SYNCD_URL=http://ingestd:8002
# The port ingestd's own HTTP server listens on (its /health and
# /sync/status endpoints). Read directly via os.Getenv in cmd/ingestd, not
# through internal/config.
# SYNCD_PORT=8002

# CIDRs allowed to set X-Forwarded-For/X-Real-IP for rate-limit identification.
# Defaults to loopback only. Set this to your actual reverse proxy/load
# balancer's address if one sits in front of go-api in production — otherwise
# every client's IP for rate limiting falls back to the proxy's own address.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Set to "production" to make the config guard in internal/config/env.go
# refuse to start on a placeholder TOKEN_ENCRYPTION_KEY/ADMIN_SYNC_TOKEN/
# GITHUB_WEBHOOK_SECRET. Leave unset for local dev.
# ENV=production

# --------------------------------------------------------------------------
# GitHub Authentication & API
# --------------------------------------------------------------------------
# GitHub OAuth App credentials (required for browser & desktop login)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# GitHub Personal Access Token (PAT)
# Used for issue catalog ingestion and fallback operations (scopes: repo, read:user)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# GitHub App — optional. Installation token drives server-side
# crawling/on-demand reads; the user-to-server token drives fork/push/PR,
# attributing that work to the user instead of the server. Leave
# GITHUB_APP_ID empty to leave this disabled and keep using the OAuth
# App/PAT above. Register at https://github.com/settings/apps/new.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_CALLBACK_URL=http://localhost:8000/auth/github-app/callback
# Host path to the App's downloaded private key (.pem); mounted read-only
# into the container at /run/secrets/github-app-private-key.pem by compose.
# Must be PKCS1 (BEGIN RSA PRIVATE KEY) — githubapp.LoadPrivateKeyFile parses
# x509.ParsePKCS1PrivateKey only, so a PKCS8 key (BEGIN PRIVATE KEY) fails.
# GITHUB_APP_PRIVATE_KEY_HOST_PATH=/absolute/path/to/your-app-private-key.pem

# HMAC secret for verifying GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=dev_local_webhook_secret

# Encrypts users.github_access_token at rest (AES-256-GCM key, derived via
# SHA-256 from this value so any length secret works). Changing it makes
# previously stored tokens undecryptable — affected users just reconnect
# GitHub, there's no migration needed. Back this up alongside database
# backups in production — a dump is useless without it.
TOKEN_ENCRYPTION_KEY=dev_local_token_encryption_key

# --------------------------------------------------------------------------
# Admin Security
# --------------------------------------------------------------------------
# Bearer token for protected administrative endpoints (/admin/*)
ADMIN_SYNC_TOKEN=dev_local_admin_sync_token

# --------------------------------------------------------------------------
# Monitoring (Prometheus + Grafana, see DEPLOYMENT.md "Monitoring")
# --------------------------------------------------------------------------
# Grafana's admin login. Required in production; dev defaults to "admin".
GRAFANA_ADMIN_PASSWORD=admin
# Key Grafana encrypts its stored secrets with (the datasource password).
# Required in production.
GRAFANA_SECRET_KEY=dev_local_grafana_secret_key
# Password for the read-only, column-restricted metrics_ro database role that
# Grafana's Postgres datasource and postgres-exporter use. Required in
# production; set on every deploy by the metrics-role one-shot service.
METRICS_DB_PASSWORD=metrics_ro_dev

# --------------------------------------------------------------------------
# Operational tunables are NOT environment variables
# --------------------------------------------------------------------------
# Rate limits, page sizes, cache TTLs, sync interval, worker counts and the
# D6 disk guardrails (ingest.max_db_size_mb, ingest.max_pages_per_repo) all
# live in the `settings` database table and can be changed on a running
# system:
#
#   curl localhost:8000/admin/config -H "Authorization: Bearer $ADMIN_SYNC_TOKEN"
#   curl -XPUT localhost:8000/admin/config/ingest.routine_workers \
#        -H "Authorization: Bearer $ADMIN_SYNC_TOKEN" -d '{"value": 4}'
#
# Every key, with defaults and bounds: docs/settings.md
#
# Setting UNAUTH_RATE_LIMIT, AUTH_RATE_LIMIT, SYNC_INTERVAL_SECONDS or
# WORKER_COUNT in the environment has no effect — those names were never
# wired to anything the code reads; use the settings table above instead.

# --------------------------------------------------------------------------
# Resource tuning (compose.prod.yaml only; defaults suit the 4GB/2vCPU VPS
# target — see DEPLOYMENT.md for the full production .env, which is placed
# directly on the host and never passes through this file or through CI)
# --------------------------------------------------------------------------
# PG_SHARED_BUFFERS=768MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# PG_WORK_MEM=8MB
# PG_MAX_CONNECTIONS=60
# PG_MAX_PARALLEL_WORKERS_PER_GATHER=1
# PG_SHM_SIZE=256mb
# PG_MEM_LIMIT=1536m
# PG_CPUS=1.0
# REDIS_MAXMEMORY=256mb
# REDIS_MEM_LIMIT=320m
# REDIS_CPUS=0.25
# API_DB_MAX_CONNS=15      # becomes DB_MAX_CONNS inside the go-api container
# API_MEM_LIMIT=384m
# API_CPUS=0.5
# INGESTD_DB_MAX_CONNS=10  # becomes DB_MAX_CONNS inside the ingestd container
# INGESTD_MEM_LIMIT=512m
# INGESTD_CPUS=0.75
# FRONTEND_MEM_LIMIT=128m
# FRONTEND_CPUS=0.25
# CADDY_MEM_LIMIT=128m
# CADDY_CPUS=0.25
# PROMETHEUS_RETENTION_TIME=15d
# PROMETHEUS_RETENTION_SIZE=2GB
# PROMETHEUS_MEM_LIMIT=256m
# PROMETHEUS_CPUS=0.25
# GRAFANA_MEM_LIMIT=384m
# GRAFANA_CPUS=0.25
# NODE_EXPORTER_MEM_LIMIT=48m
# NODE_EXPORTER_CPUS=0.1
# CADVISOR_MEM_LIMIT=96m
# CADVISOR_CPUS=0.15
# POSTGRES_EXPORTER_MEM_LIMIT=48m
# POSTGRES_EXPORTER_CPUS=0.1
# REDIS_EXPORTER_MEM_LIMIT=32m
# REDIS_EXPORTER_CPUS=0.1
