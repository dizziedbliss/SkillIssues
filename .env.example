# ==============================================================================
# SkillIssues Environment Configuration
# ==============================================================================

# --------------------------------------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------------------------------------
POSTGRES_DB=skillissues
POSTGRES_USER=skillissues
POSTGRES_PASSWORD=skillissues
DATABASE_URL=postgresql://skillissues:skillissues@localhost:5432/skillissues

# --------------------------------------------------------------------------
# Redis (Session cache, rate limiting, distributed sync locks)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# URLs & Ports
# --------------------------------------------------------------------------
PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# --------------------------------------------------------------------------
# GitHub Authentication & API
# --------------------------------------------------------------------------
# GitHub OAuth App credentials (required for browser & desktop login)
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# GitHub Personal Access Token (PAT)
# Used for issue catalog ingestion and fallback operations (scopes: repo, read:user)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# HMAC secret for verifying GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=dev_local_webhook_secret

# --------------------------------------------------------------------------
# Admin Security
# --------------------------------------------------------------------------
# Bearer token for protected administrative endpoints (/admin/*)
ADMIN_SYNC_TOKEN=dev_local_admin_sync_token

# --------------------------------------------------------------------------
# Operational tunables are NOT environment variables
# --------------------------------------------------------------------------
# Rate limits, page sizes, cache TTLs, sync interval and worker counts live in
# the `settings` database table and can be changed on a running system:
#
#   curl localhost:8000/admin/config -H "Authorization: Bearer $ADMIN_SYNC_TOKEN"
#   curl -XPUT localhost:8000/admin/config/ingest.sync_interval_seconds \
#        -H "Authorization: Bearer $ADMIN_SYNC_TOKEN" -d '{"value": 300}'
#
# Setting UNAUTH_RATE_LIMIT, AUTH_RATE_LIMIT, SYNC_INTERVAL_SECONDS or
# WORKER_COUNT in the environment now has no effect.

# --------------------------------------------------------------------------
# Resource tuning (docker-compose.prod.yml only; defaults suit 4GB / 2 vCPU)
# --------------------------------------------------------------------------
# Raise shared_buffers if the host has more RAM: it decides how much of the
# issue catalog stays cached, which is the main driver of query latency.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=40

# Redis holds rate-limit counters and cached responses only, and is not
# persisted. A hard cap keeps cached data from evicting the counters.
REDIS_MAXMEMORY=256mb
