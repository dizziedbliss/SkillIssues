# ==============================================================================
# SkillIssues Environment Configuration
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ==============================================================================

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
POSTGRES_DB=skillissues
POSTGRES_USER=skillissues
POSTGRES_PASSWORD=replace_with_strong_password_in_production

# Full connection string (used by Go API, syncd, and worker)
DATABASE_URL=postgresql://skillissues:skillissues@localhost:5432/skillissues

# --------------------------------------------------------------------------
# Redis (session cache, rate limiting, distributed locks)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# API & Security
# --------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
SKILLISSUES_API_URL=http://localhost:8000

# Rate Limiting (Requests per hour - GitHub style)
UNAUTH_RATE_LIMIT=180
AUTH_RATE_LIMIT=1000

# Bearer token for /admin/* endpoints — generate with:
#   openssl rand -hex 32
ADMIN_SYNC_TOKEN=replace_with_secure_random_admin_token

# --------------------------------------------------------------------------
# GitHub OAuth App (for web and desktop login via GitHub)
# Create an OAuth App at: https://github.com/settings/developers
# --------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# HMAC secret for verifying GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# --------------------------------------------------------------------------
# GitHub Personal Access Token
# Used for catalog ingestion and as fallback when users have no stored token.
# Needs: repo, read:user scopes.
# --------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_pat_token

# --------------------------------------------------------------------------
# Kaggle Dataset ETL (Optional metadata dataset)
# Used to download the pelmers/github-repository-metadata-with-5-stars dataset.
# Get credentials at: https://www.kaggle.com/settings/account
# --------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --------------------------------------------------------------------------
# Catalog Ingestion Tuning
# --------------------------------------------------------------------------
MAX_REPOSITORIES=500
MIN_STARS=50
SYNC_ISSUES=true
SYNC_INTERVAL_SECONDS=900

# --------------------------------------------------------------------------
# Go API Server & Services
# --------------------------------------------------------------------------
PORT=8000
WORKER_COUNT=4
PRIORITY_WORKER_COUNT=2
ON_DEMAND_WORKER_COUNT=8
LOG_LEVEL=info
SYNCD_URL=http://syncd:8002
